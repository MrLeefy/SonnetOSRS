[Unit]
Description=OLDSKOOL authoritative Grand Exchange PvP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/opt/oldskool
ExecStart=/opt/oldskool/oldskool-server
Environment=SONNET_BIND=127.0.0.1:8788
Environment=SONNET_STATE=/var/lib/oldskool/profiles.json
Environment=OLDSKOOL_COLLISION=/opt/oldskool/world_collision.json
Environment=OLDSKOOL_RESIDENTS=20
Environment=OLDSKOOL_ALLOWED_ORIGINS=https://oldskool-phi.vercel.app,http://127.0.0.1:8000,http://localhost:8000
Environment=RUST_LOG=oldskool_server=info,tower_http=warn
Restart=on-failure
RestartSec=2
TimeoutStopSec=12
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/oldskool
MemoryMax=768M
TasksMax=256
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
