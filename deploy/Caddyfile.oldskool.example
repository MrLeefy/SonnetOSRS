oldskool-api.129.146.39.132.sslip.io {
    encode zstd gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        Cache-Control "no-store"
    }
    reverse_proxy 127.0.0.1:8788 {
        header_up X-Real-IP {remote_host}
    }
}
